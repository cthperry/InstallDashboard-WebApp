{
  "extends": "./tsconfig.json",
  "compilerOptions": {
    "incremental": false,
    "isolatedModules": false,
    "module": "CommonJS",
    "moduleResolution": "node",
    "noEmit": false,
    "noEmitOnError": true,
    "outDir": ".tmp/unit",
    "rootDir": ".",
    "tsBuildInfoFile": ".tmp/unit.tsbuildinfo"
  },
  "include": [
    "tests/**/*.ts"
  ],
  "exclude": [
    "node_modules",
    ".next",
    ".tmp"
  ]
}
