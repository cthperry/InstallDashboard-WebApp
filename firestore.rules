rules_version = '2';

service cloud.firestore {
  match /databases/{database}/documents {

    function isSignedIn() {
      return request.auth != null
          && request.auth.token.email is string
          && request.auth.token.email.matches('^[^@]+@premtek\\.com\\.tw$');
    }

    function isAdmin() {
      return isSignedIn()
          && exists(/databases/$(database)/documents/users/$(request.auth.uid))
          && get(/databases/$(database)/documents/users/$(request.auth.uid)).data.role == 'admin';
    }

    function isPremtekEmail(value) {
      return value is string && value.matches('^[^@]+@premtek\\.com\\.tw$');
    }

    function isSelf(userId) {
      return isSignedIn() && request.auth.uid == userId;
    }

    function isUserRole(value) {
      return value == 'admin' || value == 'engineer';
    }

    function isValidUserProfile(data) {
      return data.keys().hasOnly(['email', 'role', 'updatedAt', 'updatedBy', 'createdAt', 'updatedAtServer'])
        && isPremtekEmail(data.email)
        && isUserRole(data.role)
        && isOptionalNumber(data.updatedAt)
        && isOptionalShortString(data.updatedBy, 120);
    }

    function isValidSelfUserProfile(userId) {
      return isSelf(userId)
        && isValidUserProfile(request.resource.data)
        && request.resource.data.email == request.auth.token.email
        && request.resource.data.role == 'engineer'
        && (!exists(/databases/$(database)/documents/users/$(userId))
          || resource.data.role == request.resource.data.role);
    }

    function isRegion(value) {
      return value == 'north' || value == 'central' || value == 'south';
    }

    function isPhase(value) {
      return value == 'ordered' || value == 'shipping' || value == 'arrived' || value == 'installing' || value == 'trial' || value == 'qual' || value == 'released';
    }

    function isEquipmentStatus(value) {
      return value == '裝機' || value == '試產' || value == '正式生產中';
    }

    function isOptionalShortString(value, maxLen) {
      return value == null || (value is string && value.size() <= maxLen);
    }

    function isNumberLike(value) {
      return value is int || value is float;
    }

    function isOptionalNumber(value) {
      return value == null || isNumberLike(value);
    }

    function isValidInstallation(data) {
      return data.keys().hasOnly([
          'name', 'serialKey', 'importKey', 'modelCode', 'region', 'customer',
          'phase', 'engineer', 'custContact', 'custPhone', 'orderDate',
          'estArrival', 'estComplete', 'actArrival', 'actComplete', 'notes',
          'progress', 'checklist', 'createdAt', 'updatedAt',
          'createdAtServer', 'updatedAtServer'
        ])
        && data.name is string
        && data.name.size() <= 80
        && isOptionalShortString(data.serialKey, 80)
        && isOptionalShortString(data.importKey, 220)
        && data.modelCode is string
        && data.modelCode.size() > 0
        && data.modelCode.size() <= 60
        && isRegion(data.region)
        && data.customer is string
        && data.customer.size() > 0
        && data.customer.size() <= 80
        && isPhase(data.phase)
        && data.engineer is string
        && data.engineer.size() <= 40
        && isOptionalShortString(data.custContact, 40)
        && isOptionalShortString(data.custPhone, 40)
        && isOptionalShortString(data.orderDate, 20)
        && isOptionalShortString(data.estArrival, 20)
        && isOptionalShortString(data.estComplete, 20)
        && isOptionalShortString(data.actArrival, 20)
        && isOptionalShortString(data.actComplete, 20)
        && isOptionalShortString(data.notes, 400)
        && isNumberLike(data.progress)
        && data.progress >= 0
        && data.progress <= 100
        && (data.checklist == null || data.checklist is map)
        && isOptionalNumber(data.createdAt)
        && isOptionalNumber(data.updatedAt);
    }

    function isValidMilestones(data) {
      return data is map
        && data.keys().hasOnly(['installStart', 'installDone', 'trialStart', 'trialPass', 'prodStart', 'reachTargetDate'])
        && isOptionalShortString(data.installStart, 20)
        && isOptionalShortString(data.installDone, 20)
        && isOptionalShortString(data.trialStart, 20)
        && isOptionalShortString(data.trialPass, 20)
        && isOptionalShortString(data.prodStart, 20)
        && isOptionalShortString(data.reachTargetDate, 20);
    }

    function isValidBlocking(data) {
      return data == null || (
        data is map
        && data.keys().hasOnly(['reasonCode', 'detail', 'owner', 'eta'])
        && isOptionalShortString(data.reasonCode, 40)
        && isOptionalShortString(data.detail, 200)
        && isOptionalShortString(data.owner, 60)
        && isOptionalShortString(data.eta, 20)
      );
    }

    function isCapacityLevel(value) {
      return value == '綠' || value == '黃' || value == '紅';
    }

    function isValidCapacity(data) {
      return data is map
        && data.keys().hasOnly(['utilization', 'uph', 'targetUph', 'level', 'trend7d'])
        && isNumberLike(data.utilization)
        && data.utilization >= 0
        && data.utilization <= 100
        && isNumberLike(data.uph)
        && data.uph >= 0
        && isNumberLike(data.targetUph)
        && data.targetUph >= 0
        && isCapacityLevel(data.level)
        && data.trend7d is list
        && data.trend7d.size() == 7;
    }

    function isValidEquipment(data) {
      return data.keys().hasOnly([
          'equipmentId', 'region', 'customer', 'site', 'modelCode', 'serialNo',
          'serialKey', 'statusMain', 'statusSub', 'owner', 'milestones',
          'blocking', 'capacity', 'products', 'createdAt', 'updatedAt',
          'createdAtServer', 'updatedAtServer'
        ])
        && data.equipmentId is string
        && data.equipmentId.size() > 0
        && data.equipmentId.size() <= 40
        && isRegion(data.region)
        && data.customer is string
        && data.customer.size() > 0
        && data.customer.size() <= 80
        && isOptionalShortString(data.site, 80)
        && data.modelCode is string
        && data.modelCode.size() > 0
        && data.modelCode.size() <= 60
        && data.serialNo is string
        && data.serialNo.size() > 0
        && data.serialNo.size() <= 60
        && isOptionalShortString(data.serialKey, 80)
        && isEquipmentStatus(data.statusMain)
        && isOptionalShortString(data.statusSub, 80)
        && isOptionalShortString(data.owner, 60)
        && isValidMilestones(data.milestones)
        && isValidBlocking(data.blocking)
        && isValidCapacity(data.capacity)
        && (data.products == null || (data.products is list && data.products.size() <= 50))
        && isOptionalNumber(data.createdAt)
        && isOptionalNumber(data.updatedAt);
    }

    function isValidAuditLog(data) {
      return data.keys().hasOnly(['action', 'target', 'detail', 'actorEmail', 'createdAt'])
        && data.action is string
        && data.action.size() > 0
        && data.action.size() <= 80
        && data.target is string
        && data.target.size() <= 120
        && data.detail is string
        && data.detail.size() <= 500
        && data.actorEmail is string
        && data.actorEmail.size() <= 120;
    }

    function isValidEvent(data) {
      return data.keys().hasOnly(['eventName', 'payload', 'createdAt'])
        && data.eventName is string
        && data.eventName.size() > 0
        && data.eventName.size() <= 80
        && (data.payload == null || data.payload is map);
    }

    match /installations/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidInstallation(request.resource.data);
      allow delete: if isAdmin();
    }

    match /equipments/{docId} {
      allow read: if isSignedIn();
      allow create, update: if isSignedIn() && isValidEquipment(request.resource.data);
      allow delete: if isAdmin();
    }

    match /users/{userId} {
      allow read: if isAdmin() || isSelf(userId);
      allow create: if isAdmin() || isValidSelfUserProfile(userId);
      allow update: if isAdmin() && isValidUserProfile(request.resource.data);
      allow delete: if isAdmin() && request.auth.uid != userId;
    }

    match /settings/{settingId} {
      allow read: if isSignedIn();
      allow write: if isAdmin();
    }

    match /auditLogs/{logId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidAuditLog(request.resource.data);
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /events/{eventId} {
      allow read: if isAdmin();
      allow create: if isSignedIn() && isValidEvent(request.resource.data);
      allow delete: if isAdmin();
      allow update: if false;
    }

    match /{document=**} {
      allow read, write: if false;
    }
  }
}
